+/*
+ * MSI PRO X870-P WIFI (MS-7E47) voltage mapping.
+ *
+ * Built from the BIOS Hardware Monitor (BIOS E7E47AMSI.1A10, photographed
+ * 2026-09-22) and then corrected by measuring the patched driver on the
+ * machine. See lab/exp-0009 and lab/exp-0010 in the sensors-gui project.
+ *
+ * Confirmed: the generic table gives the right value under the wrong name for
+ * two channels. Register and multiplier are unchanged; only the label moves.
+ *   channel 7  "DRAM"  -> "CPU VDDIO",   BIOS 1.368 V, exact match.
+ *   channel 11 "AVCC3" -> "System 3.3V", BIOS 3.288 V, exact match.
+ *
+ * Measured: register 14 reads a steady 3.116 V. The generic table never reads
+ * it. The BIOS reports no battery voltage, so this cannot be checked against
+ * the BIOS directly, but two things point the same way: the MS-7E32 override
+ * above maps register 14 to "CMOS Battery" on a sibling MSI board, and
+ * 3.116 V is what a healthy CR2032 gives. Channel 13 is moved onto it. Its
+ * old register 13 read 2.046 V, which the BIOS shows is not a rail it knows.
+ *
+ * Measured and rejected: register 15 reads a constant 0. An earlier version
+ * of this table guessed it held the 1.8 V rail the BIOS calls "CPU 1P8"
+ * (1.793 V). It does not. Channel 5 is left on its generic register and
+ * hidden as a duplicate instead.
+ *
+ * Still unmapped: the BIOS shows "VDD MISC" 1.097 V, "CPU 1P8" 1.793 V and
+ * "CHIPSET Core" 1.047 V. No register in this chip's voltage block is known
+ * to hold them. Registers 14 and 15 were the only untried ones, and both are
+ * now accounted for.
+ *
+ * Channel 8 keeps its generic register 5 under the generic name "Chipset".
+ * It reads about 0.31 V, which the BIOS shows is not the chipset core rail.
+ * It is left visible and wrong here on purpose, so that the application layer
+ * can mark it, rather than the driver hiding a live reading of something.
+ *
+ * hidden_voltage_mask hides channels 2, 5, 6 and 12 ("+3.3V", "CPU 1P8",
+ * "CPU VDDP", "AVSB"). All four read registers 11, 9, 10 and 12, which give
+ * the same ~3.33 V: one rail reported four times under four confident names.
+ * The real 3.3 V rail is channel 11 on register 8. The four stay readable
+ * with the manual=1 module parameter; see nct6687_is_visible().
+ */
+static const struct voltage_reg_override nct6687_voltage_ms7e47_overrides[] = {
+	{ .channel = 7, .reg = 3, .multiplier = 2, .label = "CPU VDDIO" },      /* confirmed */
+	{ .channel = 11, .reg = 8, .multiplier = 1, .label = "System 3.3V" },   /* confirmed */
+	{ .channel = 13, .reg = 14, .multiplier = 1, .label = "CMOS Battery" }, /* measured, see above */
+};
+
 static struct voltage_reg nct6687_voltage_config_active[NCT6687_NUM_REG_VOLTAGE];
 
 static const char *const nct6687_manual_voltage_labels[] = {
@@ -382,14 +428,22 @@
