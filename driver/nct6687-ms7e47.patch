+/*
+ * MSI PRO X870-P WIFI (MS-7E47). The BIOS Hardware Monitor lists a ninth
+ * fan, "EZ Conn Fan" (the case fans on header JAF_1), read as a
+ * tachometer-only channel at 0x144 in the msi_alt1 mapping -- the same
+ * register the MEG Z890 GODLIKE's second pump uses, but a different header
+ * on this board, hence its own label below rather than reuse of "Pump Fan
+ * #2". See lab/exp-0009-bios-ground-truth in the sensors-gui project for
+ * the photographed BIOS readings this and the voltage table above are
+ * built from.
+ */
+static const struct nct6687_board_data nct6687_ms7e47 = {
+	.fan_channels = NCT6687_NUM_REG_FAN_MAX,
+	.default_fan_mask = NCT6687_FAN_MASK_ALL,
+	.fan9_label = "EZ Conn Fan",
+	/*
+	 * MEASURED 2026-09-22: 0x144 read a constant 0 RPM on this board while
+	 * the BIOS showed the EZ Conn fan turning at 963-1612 RPM. The default
+	 * fan table in this driver documents 0x146 as "SYS Fan 2, EZConn on
+	 * others", and 0x146 is free in the msi_alt1 mapping because the system
+	 * fans moved to 0x154-0x15E.
+	 */
+	.fan9_reg_rpm = 0x146,
+	.hidden_voltage_mask = BIT(2) | BIT(5) | BIT(6) | BIT(12),
+	.voltage_overrides = nct6687_voltage_ms7e47_overrides,
+	.voltage_override_count = ARRAY_SIZE(nct6687_voltage_ms7e47_overrides),
+};
